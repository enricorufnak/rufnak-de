# Managed by astro-kit (kit-sync overwrites this file). Changes via PR in astro-kit.
# All-Inkl (Apache). Document root: <domain>/current/public

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Did the request arrive via HTTPS (directly or behind a proxy)?
  RewriteCond %{HTTPS} =on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =https
  RewriteRule ^ - [E=KIT_HTTPS:1]
  # Project redirects (old URLs) – inserted here by the build, straight to https://www. (one hop)
  # KIT_REDIRECTS
  # http and/or without www → https://www. in one hop (URL standard); staging.* stays (deploy-tool --staging)
  RewriteCond %{ENV:KIT_HTTPS} !=1 [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} !^staging\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# Block internal files
<FilesMatch "^(kontakt\.json|REVISION)$|^\.">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # 'unsafe-inline' for Astro's inlined scripts/styles; Google only for GA after consent
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  Header unset X-Powered-By
</IfModule>

# Never index the staging subdomain (deploy-tool requires password protection)
<IfModule mod_headers.c>
  <If "%{HTTP_HOST} =~ /^staging\./i">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

# pwa-kit (only active with pwa: true): never serve sw.js and the manifest from the browser cache, otherwise updates arrive late
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/avif "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Astro assets have a hash in their name → cache permanently
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
