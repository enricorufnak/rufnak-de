# Von astro-kit verwaltet (kit-sync überschreibt diese Datei). Änderungen per PR im astro-kit.
# All-Inkl (Apache). Document Root: <domain>/current/public

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Anfrage kam per HTTPS (direkt oder hinter Proxy)?
  RewriteCond %{HTTPS} =on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =https
  RewriteRule ^ - [E=KIT_HTTPS:1]
  # Projekt-Weiterleitungen (alte URLs) – setzt der Build hier ein, direkt auf https://www. (ein Sprung)
  # KIT_REDIRECTS
  # http und/oder ohne www → https://www. in einem Sprung (URL-Standard); staging.* bleibt (deploy-tool --staging)
  RewriteCond %{ENV:KIT_HTTPS} !=1 [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} !^staging\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# Interne Dateien sperren
<FilesMatch "^(kontakt\.json|REVISION)$|^\.">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # 'unsafe-inline' für Astros eingebettete Skripte/Styles; Google nur für GA nach Einwilligung
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  Header unset X-Powered-By
</IfModule>

# Staging-Subdomain nie indexieren (Passwortschutz setzt deploy-tool voraus)
<IfModule mod_headers.c>
  <If "%{HTTP_HOST} =~ /^staging\./i">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

# pwa-kit (nur aktiv mit pwa: true): sw.js und Manifest nie aus dem Browser-Cache, sonst kommen Updates verspätet an
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/avif "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Astro-Assets haben Hash im Namen → dauerhaft cachen
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
