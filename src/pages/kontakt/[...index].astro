---
// Managed by astro-kit (kit-sync overwrites this file). Changes via PR in astro-kit.
// /kontakt/ is only generated when contact.enabled = true in site.config.ts.
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../kit/components/ContactForm.astro';
import { site } from '../../../site.config';
import { contactEnabled } from '../../kit/types';

export function getStaticPaths() {
  return contactEnabled(site) ? [{ params: { index: undefined } }] : [];
}
---

<Layout title="Kontakt" description={`Kontakt zu ${site.name}`}>
  <div class="kit-page">
    <h1>Kontakt</h1>
    <ContactForm />
  </div>
</Layout>
