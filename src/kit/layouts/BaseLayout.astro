---
// Managed by astro-kit (kit-sync overwrites this file). Changes via PR in astro-kit.
// Frame without design: <head> (title, description, robots, canonical, Open Graph, favicon, PWA if enabled), skip link, consent banner.
// Header, footer and styles come from the project's own src/layouts/Layout.astro, which uses this frame.
// robots is set only here: noindex pages are therefore left out of the sitemap automatically (kit() in integration.ts).
import { site } from '../../../site.config';
import { isNoindex } from '../seo';
import { analyticsId, ogImagePath } from '../types';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/base.css';

interface Props {
  title?: string;
  description?: string;
  /** forces noindex (e.g. from frontmatter); otherwise the rules from seo.ts apply */
  noindex?: boolean;
  /** path or URL of a preview image (1200×630) */
  image?: string;
  /** CSS classes for <body> (e.g. Tailwind) */
  bodyClass?: string;
}

if (import.meta.env.KIT_CORE !== '1') {
  throw new Error("astro.config.mjs: integrations: [...kit()] aus './src/kit/integration.ts' fehlt (URL-Standard, Sitemap, Weiterleitungen).");
}
const { title, description = site.description, noindex = false, image, bodyClass } = Astro.props;
const fullTitle = title && title !== site.name ? `${title} | ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, site.url).href;
const robots = noindex || isNoindex(Astro.url.pathname, site) ? 'noindex, follow' : 'index, follow';
const ogImage = new URL(image ?? ogImagePath(site), site.url).href;
const ga4Id = analyticsId(site);
---

<!doctype html>
<html lang={site.lang ?? 'de'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {site.themeColor && <meta name="theme-color" content={site.themeColor} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {site.pwa && <link rel="manifest" href="/manifest.webmanifest" />}
    {site.pwa && <link rel="apple-touch-icon" href="/pwa/apple-touch-icon.png" />}
    {
      site.pwa && (
        <script is:inline>
          if ('serviceWorker' in navigator) addEventListener('load', () => navigator.serviceWorker.register('/sw.js', { scope: '/', updateViaCache: 'none' }));
        </script>
      )
    }
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="kit-skip" href="#inhalt">Zum Inhalt springen</a>
    <slot />
    {ga4Id && <CookieBanner ga4Id={ga4Id} />}
  </body>
</html>
