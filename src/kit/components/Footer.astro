---
// Managed by astro-kit (kit-sync overwrites this file). Changes via PR in astro-kit.
// Default footer for src/layouts/Layout.astro; custom footers use LegalLinks.
import { site } from '../../../site.config';
import LegalLinks from './LegalLinks.astro';
const year = new Date().getFullYear();
---

<footer class="kit-footer">
  <div class="kit-wrap kit-footer__inner">
    <p>© {year} {site.name}</p>
    <nav class="kit-footer__links" aria-label="Rechtliches">
      <LegalLinks />
    </nav>
  </div>
</footer>
