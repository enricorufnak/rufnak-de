---
// Managed by astro-kit (kit-sync overwrites this file). Changes via PR in astro-kit.
// Required links for every footer: contact (if enabled), imprint, privacy, cookie settings (if GA is enabled).
// Use in custom footers: <nav class="…"><LegalLinks linkClass="hover:underline" /></nav>
import { site } from '../../../site.config';
import { analyticsId, contactEnabled } from '../types';

interface Props {
  /** CSS classes for each link (e.g. Tailwind) */
  linkClass?: string;
}
const { linkClass } = Astro.props;
---

{contactEnabled(site) && <a href="/kontakt/" class={linkClass}>Kontakt</a>}
<a href="/impressum/" class={linkClass}>Impressum</a>
<a href="/datenschutz/" class={linkClass}>Datenschutz</a>
{analyticsId(site) && (
  <button type="button" class:list={['kit-linkbutton', linkClass]} data-kit-consent-open>Cookie-Einstellungen</button>
)}
